{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
    "logo": {
        "type": "small",
        // "type": "auto",
        "source": "arch",
        "padding": {
            "top": 6,
            "left": 3,
            "right": 3
        },
        "color": {
            "1": "#aab2c0", //natural
            "2": "#aab2c0" //natural
        }
    },
    "display": {
        "separator": "  ",
        // "constants": [
        //     "────────────────────"
        // ],
        "color": {
            "separator": "239",
            "keys": "#a9f7be", //color
            // "keys": "#79a617", //color
            "output": "#aab2c0" //natural
        },
        "key": {
            "type": "both",
            "width": 13
        },
        "size": {
            "maxPrefix": "GB",
            "ndigits": 1
        }
    },
    "modules": [
        "break",
        "break",
        "break",
        // {
        //     "type": "custom",
        //     "format": "┌{$1} {#1}Hardware{#} {$1}┐"
        // },
        {
            "type": "custom",
            "format": "{#}┌───────────── Hardware ───────────────{#}"
        },
        // {
        //     "type": "custom",
        //     "format": "{#@239}------------------------------{#}"
        // },
        {
            "type": "cpu",
            "key": "cpu",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "gpu",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "memory",
            "format": "{used} / {total}"
        },
        {
            "type": "disk",
            "key": "disk",
            "folders": "/",
            "format": "{size-used} / {size-total}"
        },
        // {
        //     "type": "custom",
        //     "format": "├{$1} {#1}Software{#} {$1}┤"
        // },
        {
            "type": "custom",
            "format": "{#}├───────────── Software ───────────────{#}"
        },
        {
            "type": "kernel",
            "key": "kernel",
            "format": "{release}"
        },
        {
            "type": "uptime",
            "key": "uptime"
        },
        {
            "type": "packages",
            "key": "packages",
            "combined": true
        },
        {
            "type": "shell",
            "key": "shell"
        },
        {
            "type": "wm",
            "key": "wm"
        },
        {
            "type": "terminal",
            "key": "terminal"
        },
        {
            "type": "localip",
            "key": "local ip",
            "format": "{ipv4}"
        },
        {
            "type": "custom",
            "format": "{#}└──────────────────────────────────────{#}"
        }
        // {
        //     "type": "custom",
        //     "format": "└{$1}──────────{$1}┘"
        // }
    ]
}
